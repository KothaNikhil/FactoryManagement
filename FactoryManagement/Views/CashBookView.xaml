<UserControl x:Class="FactoryManagement.Views.CashBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:FactoryManagement.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SummaryCard Grid.Column="0"
                                  Label="Cash in Hand"
                                  Value="{Binding CurrentCashInHand, StringFormat='₹{0:N2}'}"
                                  Icon="💰"
                                  CardBackground="{StaticResource Card.Success}"
                                  LabelForeground="{StaticResource Card.Success.Label}"/>
            <controls:SummaryCard Grid.Column="2"
                                  Label="Today Expected"
                                  Value="{Binding TodayExpectedClosing, StringFormat='₹{0:N2}'}"
                                  Icon="📊"
                                  CardBackground="{StaticResource Card.Info}"
                                  LabelForeground="{StaticResource Card.Info.Label}"/>
            <controls:SummaryCard Grid.Column="4"
                                  Label="Unreconciled"
                                  Value="{Binding UnreconciledDays, StringFormat='{}{0} days'}"
                                  Icon="⏳"
                                  CardBackground="{StaticResource Card.Warning}"
                                  LabelForeground="{StaticResource Card.Warning.Label}"/>
            <controls:SummaryCard Grid.Column="6"
                                  Label="Discrepancies"
                                  Value="{Binding TotalDiscrepancies, StringFormat='₹{0:N2}'}"
                                  Icon="⚠️"
                                  CardBackground="{StaticResource Card.Danger}"
                                  LabelForeground="{StaticResource Card.Danger.Label}"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- Opening Balance Form (shown when not initialized) -->
            <Border Style="{StaticResource FormCard}"
                    Visibility="{Binding ShowOpeningBalanceForm, Converter={StaticResource BooleanToVisibilityConverter}}"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" Height="533" Width="567">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <controls:SectionHeader Title="Setup Cash Book"
                                            Subtitle="Enter your current cash balance to get started"
                                            Icon="💰"
                                            IconBackground="{StaticResource Card.Info}"
                                            Margin="0,0,0,30"/>

                    <!-- Date -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Date *"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="2"
                                    SelectedDate="{Binding OpeningBalanceDate}"
                                    Style="{StaticResource DatePicker.Standard}"/>
                    </Grid>

                    <!-- Amount -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Opening Cash Balance (₹) *"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding OpeningBalanceAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Standard}"
                                 materialDesign:HintAssist.Hint="Enter current cash you have"/>
                    </Grid>

                    <!-- Notes -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Notes"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,0"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding OpeningBalanceNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBox.Standard}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"/>
                    </Grid>

                    <!-- Button -->
                    <Button Content="Set Opening Balance"
                            Command="{Binding SetOpeningBalanceCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Center"
                            Width="200"
                            Height="40"/>

                    <!-- Error/Success Messages -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorColor}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{StaticResource SuccessColor}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Main Cash Book Grid (shown when initialized) -->
            <Grid Visibility="{Binding IsInitialized, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Reconciliation Form / Actions -->
                <Border Grid.Column="0" Style="{StaticResource FormCard}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <controls:SectionHeader Title="Reconcile Cash"
                                                Subtitle="End-of-day cash counting"
                                                Icon="✅"
                                                IconBackground="{StaticResource Card.Success}"/>

                        <!-- Date -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Date *"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding ReconciliationDate}"
                                        Style="{StaticResource DatePicker.Standard}"/>
                        </Grid>

                        <!-- Expected Closing (Info) -->
                        <Border Background="{StaticResource SecondaryBackground}"
                                BorderBrush="{StaticResource BorderPrimary}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Expected Closing Balance"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="{StaticResource FontSize.ExtraSmall}"/>
                                <TextBlock Text="{Binding TodayExpectedClosing, StringFormat='₹{0:N2}'}"
                                           Foreground="{StaticResource Text.Primary}"
                                           FontSize="{StaticResource FontSize.Large}"
                                           FontWeight="Bold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Actual Cash Counted -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       VerticalAlignment="Center">
                                <Run Text="Actual cash"/>
                                <LineBreak/>
                                <Run Text="counted (₹) *"/> 
                            </TextBlock>
                            <TextBox Grid.Column="2"
                                     Text="{Binding ActualCashCounted, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Standard}"
                                     materialDesign:HintAssist.Hint="Count physical cash"/>
                        </Grid>

                        <!-- Discrepancy Reason -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       VerticalAlignment="Center">
                                <Run Text="Discrepancy"/>
                                <LineBreak/>            
                                <Run Text="Reason"/>
                            </TextBlock>

                            <TextBox Grid.Column="2"
                                     Text="{Binding DiscrepancyReason, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Standard}"
                                     materialDesign:HintAssist.Hint="If amounts don't match, explain why"/>
                        </Grid>

                        <!-- Notes -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Notes"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding ReconciliationNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Standard}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="60"/>
                        </Grid>

                        <!-- Buttons -->
                            <Button Content="Reconcile Cash"
                                    Command="{Binding ReconcileCashCommand}"
                                    Style="{StaticResource Button.Success}"
                                    Margin="10,0,10,10"/>
                            <Button Content="Refresh Today"
                                    Command="{Binding RefreshTodayCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="10,0,10,10"/>

                        <!-- Messages -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorColor}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Margin="0,10,0,5"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessColor}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Visibility="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Middle and Right Panels remain unchanged -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Today's Cash Transactions Section -->
                    <Border Grid.Row="0" Style="{StaticResource FormCard}">
                        <!-- ... existing content unchanged ... -->
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource FormCard}">
                        <!-- ... existing content unchanged ... -->
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>